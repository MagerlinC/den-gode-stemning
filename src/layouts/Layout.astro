---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="da">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#3a1216" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,500&family=Source+Sans+3:wght@400;600&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--burgundy: #7d2a30;
		--burgundy-deep: #3a1216;
		--burgundy-ink: #26090c;
		--violet: #6a4cf0;
		--violet-soft: #b9a8ff;
		--cream: #f7f1e8;
		--cream-muted: #d9cbbd;
		--serif: 'Playfair Display', Georgia, serif;
		--sans: 'Source Sans 3', system-ui, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
	}

	body {
		background: var(--burgundy-ink);
		color: var(--cream);
		font-family: var(--sans);
		font-size: 1.125rem;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--violet-soft);
	}

	[id] {
		scroll-margin-top: 2rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>
